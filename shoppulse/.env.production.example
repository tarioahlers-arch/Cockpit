# Vorlage: nach .env.production kopieren und ausfüllen. Die Datei NIE ins Repository einchecken.

# Domain, unter der ShopPulse erreichbar ist (Caddy holt dafür das TLS-Zertifikat)
SHOPPULSE_DOMAIN=app.ihre-firma.de
SHOPPULSE_PUBLIC_URL=https://app.ihre-firma.de

# 32-Byte-Schlüssel für Zugangsdaten – erzeugen mit: openssl rand -hex 32
# Sicher aufbewahren (Passwort-Manager/Secret-Store): ohne ihn sind gespeicherte Zugangsdaten verloren.
SHOPPULSE_SECRET_KEY=
# bei Schlüsselwechsel: alter Schlüssel hier, danach `npm run rotate-secrets`
SHOPPULSE_SECRET_KEY_PREVIOUS=

# Mailversand für Einladungen und Passwort-Reset
SHOPPULSE_SMTP_URL=smtps://benutzer:passwort@smtp.ihr-anbieter.de:465
SHOPPULSE_MAIL_FROM=ShopPulse <no-reply@ihre-firma.de>

# KI-Berater (Claude) – zentral vom Plattformbetreiber bezahlt, für alle Kund:innen inklusive.
# Schlüssel: console.anthropic.com → API Keys. Zusätzlich dort ein Ausgabenlimit (Spend Limit) setzen.
ANTHROPIC_API_KEY=
# Budget je Organisation und Monat in USD (danach pausiert der Berater bis Monatsbeginn)
SHOPPULSE_AI_MONTHLY_BUDGET_USD=25
SHOPPULSE_AI_QUESTIONS_PER_HOUR=30

# Performance-Anteil in % der nachgewiesenen Mehrumsatz-Untergrenze (Wirkungsbericht)
SHOPPULSE_PERFORMANCE_FEE_PCT=10
