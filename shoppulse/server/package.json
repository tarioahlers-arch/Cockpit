{
  "name": "shoppulse-server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp src/db/schema.sql dist/db/ && cp -r src/public dist/",
    "start": "NODE_ENV=production node dist/index.js",
    "seed:demo": "tsx src/db/seedDemo.ts",
    "assign-shops": "tsx src/db/assignShops.ts",
    "test": "tsx --test src/**/*.test.ts",
    "rotate-secrets": "tsx src/db/rotateSecrets.ts"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "nodemailer": "^6.10.1",
    "undici": "^6.28.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^6.4.24",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
