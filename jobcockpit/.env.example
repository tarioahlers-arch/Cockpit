# =============================================================================
# JobCockpit – Umgebungsvariablen
# Niemals echte Keys committen. .env-Dateien sind in .gitignore.
# =============================================================================

# -----------------------------------------------------------------------------
# 1) Mobile App  ->  kopieren nach apps/mobile/.env
#    Nur EXPO_PUBLIC_* landet im App-Bundle und ist damit ÖFFENTLICH.
#    Für EAS-Builds dieselben Werte als EAS Environment Variables hinterlegen.
# -----------------------------------------------------------------------------
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# Nur für Sentry-Source-Map-Upload im EAS-Build (kein EXPO_PUBLIC_!)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=jobcockpit-mobile

# -----------------------------------------------------------------------------
# 2) Supabase Edge Functions (SECRETS)  ->  supabase/functions/.env (lokal)
#    Produktion: `npx supabase secrets set --env-file supabase/functions/.env`
#    SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY stellt Supabase
#    in Edge Functions automatisch bereit.
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# VORSCHLAG: aktuelles Sonnet-Modell statt des im Briefing genannten claude-sonnet-4
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
REVENUECAT_WEBHOOK_AUTH_TOKEN=
REVENUECAT_SECRET_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# 3) CI/CD (GitHub Actions Secrets, nicht in Dateien)
# -----------------------------------------------------------------------------
# EXPO_TOKEN=
# SUPABASE_ACCESS_TOKEN=
# SUPABASE_DB_PASSWORD=
# SUPABASE_PROJECT_REF=
